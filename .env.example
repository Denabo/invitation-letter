# Optional browser-facing RSVP endpoint.
# Default is /api/rsvp.php when the PHP file is uploaded next to the built site.
VITE_RSVP_API_URL=/api/rsvp.php

# MySQL credentials are inserted manually in api/rsvp.php on the hosting side.
# Do not put database passwords into VITE_* variables: they are bundled into browser code.
